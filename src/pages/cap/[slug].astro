---
import Layout from '~/layouts/Layout.astro';
import SectionBar from '~/components/SectionBar.astro';
import ChapterContent from '~/components/ChapterContent.astro';
import ChapterTOC from '~/components/ChapterTOC.astro';
import Exercise from '~/components/Exercise.astro';
import Pager from '~/components/Pager.astro';
import { chapterIndex, getChapter } from '~/lib/chapters';
import { indexHref, practiceHref } from '~/lib/paths';

export function getStaticPaths() {
  return chapterIndex.map(ch => ({ params: { slug: ch.slug } }));
}

const { slug } = Astro.params;
const chapter = getChapter(slug!);
if (!chapter) {
  throw new Error(`Capitulum não encontrado: ${slug}`);
}

const numeralLower = chapter.numeral.toLowerCase();
const pageTitle = `Cap. ${chapter.numeral} — ${chapter.title} · Lingua Latīna`;
const exerciseCount = (chapter.exercises || []).length;
---

<Layout title={pageTitle} activeSlug={slug}>
  <SectionBar chapter={chapter} />

  <div class="wrap">
    <header class="chapter-header">
      <div class="eyebrow">Lingua Latīna · Exercitia</div>
      <h1>
        <span class="roman">Capitulum {chapter.numeral}</span>
        <span class="name">{chapter.title}</span>
      </h1>
      {chapter.blurb && <p class="blurb" set:html={chapter.blurb} />}
    </header>

    <ChapterContent chapter={chapter} />

    <h2 class="section-title" id="exercitia-title">
      ✎ Exercitia <span class="roman">· cap. {numeralLower}</span>
      <span
        class="session-tally"
        data-exercise-count={String(exerciseCount)}
        aria-live="polite"
        hidden
      ></span>
    </h2>

    <details class="usage-hint-inline">
      <summary><strong>Ūsus</strong> — como usar esta página</summary>
      <p>
        Escreva nas lacunas (os macrons são opcionais). Pressione <kbd>Enter</kbd> para ir ao
        próximo campo, ou para corrigir quando estiver no último. <em>Corrige</em> marca certo e
        errado <strong>sem</strong> revelar as respostas; <em>Iterum tentā</em> apaga só o que
        errou, para você tentar de novo. Só depois disso vale abrir <em>Aperī responsa</em>.
        Em exercício que custa, clica <em>Vide explicātionem</em> para revisar a regra.
      </p>
    </details>

    <ChapterTOC chapter={chapter} />

    <section>
      {(chapter.exercises || []).map(ex => (
        <Exercise exercise={ex} chapter={chapter} />
      ))}
    </section>

    <p class="chapter-practice-link">
      <a href={practiceHref({ de: chapterIndex[0].slug, ate: slug! })}>
        ❦ Praticar os paradigmas até o cap. {chapter.numeral}
      </a>
    </p>

    <Pager activeSlug={slug!} />

    <div class="colophon">
      Capitulum {chapter.numeral} — <em>{chapter.title}</em><br />
      <a href={indexHref()}>Tornāre ad initium</a>
    </div>
  </div>

  <script>
    import '~/scripts/exercise-runtime';
  </script>
</Layout>
