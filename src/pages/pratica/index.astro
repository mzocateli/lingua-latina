---
import Layout from '~/layouts/Layout.astro';
import { chapterIndex } from '~/data/chapters';
import { practiceHref } from '~/lib/paths';

const pageTitle = 'Prāctica — Lingua Latīna';
const firstSlug = chapterIndex[0].slug;
const lastChapter = chapterIndex[chapterIndex.length - 1];

/** Shortcuts into the same config the panel edits — each is just a URL, so the
 *  page has no state of its own to remember. */
const presets = [
  {
    label: `Tudo até ${lastChapter.numeral}`,
    href: practiceHref({ de: firstSlug, ate: lastChapter.slug }),
    title: 'Todo o material desbloqueado até o último capítulo',
  },
  {
    label: 'Só a 3ª declinação',
    href: practiceHref({ de: firstSlug, ate: lastChapter.slug, pos: 'noun', decl: '3' }),
    title: 'Substantivos da terceira declinação',
  },
  {
    label: 'Só verbos',
    href: practiceHref({ de: firstSlug, ate: lastChapter.slug, pos: 'verb' }),
    title: 'Conjugação, ativa e passiva',
  },
  {
    label: `Novidades do cap. ${lastChapter.numeral}`,
    href: practiceHref({ de: lastChapter.slug, ate: lastChapter.slug }),
    title: 'Só o que o último capítulo introduziu',
  },
];
---

<Layout
  title={pageTitle}
  description="Prática configurável de declinação e conjugação, gerada dinamicamente a partir do intervalo de capítulos já estudado."
  activeSlug="pratica"
>
  <div class="wrap">
    <header class="chapter-header">
      <div class="eyebrow">Lingua Latīna · Prāctica</div>
      <h1>
        <span class="name">Dēclīnātiō et coniugātiō</span>
      </h1>
      <p class="blurb">
        Tabelas de paradigma geradas na hora. A página já abre com uma para preencher —
        use os atalhos abaixo ou abra <em>Ajustar</em> para escolher o intervalo de
        capítulos e as categorias. A configuração fica na barra de endereço, então o
        link pode ser guardado ou compartilhado.
      </p>
    </header>

    <nav class="preset-bar" aria-label="Atalhos de configuração">
      {presets.map(p => (
        <a class="preset-btn" href={p.href} title={p.title}>{p.label}</a>
      ))}
    </nav>

    <details id="practice-config-box" class="practice-config-box">
      <summary class="practice-config-summary">
        <span class="practice-config-summary-label">Ajustar</span>
        <span id="cfg-summary" class="practice-config-summary-text"></span>
      </summary>

      <form id="practice-config" class="practice-config">
        <fieldset>
          <legend>Intervalo de capítulos</legend>
          <label>
            A partir do capítulo
            <select id="cfg-min" name="minChapter">
              {chapterIndex.map(ch => (
                <option value={ch.slug} selected={ch.slug === firstSlug}>
                  {ch.numeral} — {ch.title}
                </option>
              ))}
            </select>
          </label>
          <label>
            Até o capítulo
            <select id="cfg-max" name="maxChapter">
              {chapterIndex.map(ch => (
                <option value={ch.slug} selected={ch.slug === lastChapter.slug}>
                  {ch.numeral} — {ch.title}
                </option>
              ))}
            </select>
          </label>
          <p class="practice-config-hint">
            Só entra no sorteio o que foi ensinado dentro desse intervalo — subir o
            ponto de partida serve para pular o que já saiu automático.
          </p>
        </fieldset>

        <fieldset>
          <legend>Categoria</legend>
          <label><input type="checkbox" name="pos" value="noun" checked /> Substantivos</label>
          <label><input type="checkbox" name="pos" value="verb" checked /> Verbos</label>
        </fieldset>

        <fieldset id="cfg-declensions">
          <legend>Declinações</legend>
          <label><input type="checkbox" name="declension" value="1" checked /> 1ª</label>
          <label><input type="checkbox" name="declension" value="2" checked /> 2ª</label>
          <label><input type="checkbox" name="declension" value="3" checked /> 3ª</label>
          <label><input type="checkbox" name="declension" value="4" checked /> 4ª</label>
        </fieldset>

        <fieldset id="cfg-cases">
          <legend>Casos</legend>
          <label><input type="checkbox" name="case" value="nom" checked /> nōminātīvus</label>
          <label><input type="checkbox" name="case" value="gen" checked /> genetīvus</label>
          <label><input type="checkbox" name="case" value="dat" checked /> datīvus</label>
          <label><input type="checkbox" name="case" value="acc" checked /> accūsātīvus</label>
          <label><input type="checkbox" name="case" value="abl" checked /> ablātīvus</label>
          <label><input type="checkbox" name="case" value="voc" checked /> vocātīvus</label>
        </fieldset>

        <fieldset id="cfg-conjugations">
          <legend>Conjugações</legend>
          <label><input type="checkbox" name="conjugation" value="1" checked /> 1ª</label>
          <label><input type="checkbox" name="conjugation" value="2" checked /> 2ª</label>
          <label><input type="checkbox" name="conjugation" value="3" checked /> 3ª</label>
          <label><input type="checkbox" name="conjugation" value="4" checked /> 4ª</label>
        </fieldset>

        <fieldset id="cfg-voices">
          <legend>Voz verbal</legend>
          <label><input type="checkbox" name="voice" value="active" checked /> āctīva</label>
          <label><input type="checkbox" name="voice" value="passive" checked /> passīva</label>
        </fieldset>

        <fieldset>
          <legend>Repetição</legend>
          <label><input type="checkbox" id="cfg-no-repeat" name="noRepeat" checked /> Evitar repetir lemas já sorteados</label>
        </fieldset>
      </form>
    </details>

    <div class="practice-actions">
      <button type="button" id="cfg-generate" class="grade-btn">Gerā tabulam</button>
      <p id="cfg-empty-msg" class="practice-config-hint practice-config-empty" hidden>
        Nenhuma combinação disponível nesse intervalo — amplie o capítulo final
        ou baixe o ponto de partida.
      </p>
    </div>

    <div id="paradigm-practice-root"></div>
  </div>

  <script>
    import '~/scripts/paradigm-practice';
  </script>
</Layout>
