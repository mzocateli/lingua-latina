---
import { chapterIndex } from '~/lib/chapters';
import { chapterHref, indexHref, practiceHref } from '~/lib/paths';

interface Props {
  activeSlug?: string | null;
}

const { activeSlug = null } = Astro.props;
const activeChapter = chapterIndex.find(ch => ch.slug === activeSlug);
---

<nav class="site-nav" aria-label="Navegação principal">
  <div class="site-nav-inner">
    <a class="site-brand" href={indexHref()}>Lingua Latīna</a>
    <div class="site-nav-spacer"></div>
    <ul class="site-nav-list">
      <li class="site-nav-capitula">
        <details>
          <summary aria-haspopup="true">
            {activeChapter && <span class="num">{activeChapter.numeral}</span>}
            {activeChapter ? 'Capitulum' : 'Capitula'}
          </summary>
          <ul class="site-nav-capitula-menu">
            {chapterIndex.map(ch => (
              <li>
                <a href={chapterHref(ch.slug)} class={ch.slug === activeSlug ? 'active' : ''}>
                  <span class="num">{ch.numeral}</span>
                  <span class="title">{ch.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
      <li>
        <a
          href={practiceHref()}
          class={activeSlug === 'pratica' ? 'active' : ''}
          title="Prática configurável de declinação e conjugação"
        >
          Prāctica
        </a>
      </li>
    </ul>
  </div>
</nav>
