---
import { getEntry } from 'astro:content';
import type { Chapter } from '~/lib/types';

interface Props {
  refs: string[] | undefined;
  chapter: Chapter;
}

const { refs, chapter } = Astro.props;
const slug = chapter.slug;

const entries = await Promise.all(
  (refs || []).map(id => getEntry('topics', `${slug}/${id}`))
);
const matched = entries
  .filter((e): e is NonNullable<typeof e> => !!e)
  .map(e => ({
    id: e.id.replace(/^[^/]+\//, '').replace(/\.md$/, ''),
    title: e.data.title,
  }));

function stripHtml(s: string): string {
  return s.replace(/<[^>]+>/g, '');
}
---

{matched.length === 1 && (
  <a
    class="ref-btn"
    href={`#content-${matched[0].id}`}
    title={`Vide: ${stripHtml(matched[0].title)}`}
  >❦ Vide explicātionem</a>
)}

{matched.length > 1 && (
  <div class="ref-btn-group">
    <span class="ref-btn-label">Vide:</span>
    {matched.map(t => (
      <a
        class="ref-btn ref-btn-small"
        href={`#content-${t.id}`}
        title={`Vide: ${stripHtml(t.title)}`}
      >{stripHtml(t.title)}</a>
    ))}
  </div>
)}
