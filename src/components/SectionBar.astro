---
import { getEntry } from 'astro:content';
import type { Chapter } from '~/lib/types';
import { grammarOf, topicsOf } from '~/lib/content';

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const slug = chapter.slug;

const grammarCount = (await grammarOf(slug)).length;
const topicsCount = (await topicsOf(slug)).length;
const vocabEntry = await getEntry('vocabulary', slug);

const hasGrammar = grammarCount > 0 || !!chapter.grammarIntro;
const hasVocab = !!(vocabEntry?.data.groups && vocabEntry.data.groups.length);
const hasTopics = topicsCount > 0;
---

<nav class="section-bar" aria-label="Saltar para seção">
  <ul class="section-bar-list">
    {hasGrammar && (
      <li><a href="#grammatica" class="section-bar-link">§ Grammatica</a></li>
    )}
    {hasVocab && (
      <li><a href="#vocabula" class="section-bar-link">☙ Vocābula</a></li>
    )}
    {hasTopics && (
      <li><a href="#explicationes" class="section-bar-link">❦ Explicātiōnēs</a></li>
    )}
    <li><a href="#exercitia-title" class="section-bar-link">✎ Exercitia</a></li>
  </ul>
</nav>
