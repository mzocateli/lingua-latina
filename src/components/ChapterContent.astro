---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import type { Chapter } from '~/lib/types';

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const slug = chapter.slug;
const numeralLower = String(chapter.numeral || '').toLowerCase();

function stripHtml(s: string): string {
  return s.replace(/<[^>]+>/g, '');
}

// ----- Grammar sections (file-per-section, sort by filename) -----
const grammarSections = (await getCollection('grammar', (e: CollectionEntry<'grammar'>) => e.id.startsWith(`${slug}/`)))
  .sort((a, b) => a.id.localeCompare(b.id));
const grammarRendered = await Promise.all(
  grammarSections.map(async (s) => {
    const { Content } = await s.render();
    return { meta: s.data, Content };
  })
);

// ----- Topics (file-per-topic, sort by order frontmatter) -----
const topicEntries = (await getCollection('topics', (e: CollectionEntry<'topics'>) => e.id.startsWith(`${slug}/`)))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const topicsRendered = await Promise.all(
  topicEntries.map(async (t) => {
    const { Content } = await t.render();
    // Strip the `{slug}/` prefix from the collection id to get the bare topic id.
    const id = t.id.replace(/^[^/]+\//, '').replace(/\.md$/, '');
    return { id, meta: t.data, Content };
  })
);

// ----- Vocabulary (single YAML file per chapter) -----
const vocabEntry = await getEntry('vocabulary', slug);
const vocabGroups = vocabEntry?.data.groups ?? [];

// ----- Flags -----
const hasGrammar = grammarRendered.length > 0 || !!chapter.grammarIntro;
const hasVocab = vocabGroups.length > 0;
const hasTopics = topicsRendered.length > 0;
const hasAny = hasGrammar || hasVocab || hasTopics;

const grammarHeadings = grammarRendered.map(({ meta }) => meta.heading).filter(Boolean);
const totalVocabEntries = vocabGroups.reduce((n, g) => n + g.entries.length, 0);
const vocabLabels = vocabGroups.map(g => stripHtml(g.label));
const topicNames = topicsRendered.map(({ meta }) => stripHtml(meta.title));
---

{hasAny && (
  <section class="content-section">
    {hasGrammar && (
      <details class="grammar-section" id="grammatica">
        <summary class="grammar-summary">
          <span class="section-marker">§</span>
          <span class="section-title-inline" set:html={`Grammatica Latīna <span class="roman">· cap. ${numeralLower}</span>`} />
          {grammarHeadings.length > 0 && (
            <span class="section-summary-list" set:html={grammarHeadings.join(' · ')} />
          )}
        </summary>
        {chapter.grammarIntro && (
          <p class="grammar-intro" set:html={chapter.grammarIntro} />
        )}
        {grammarRendered.map(({ meta, Content }) => (
          <details class="grammar-block" open>
            <summary class="grammar-block-summary">
              {meta.heading && <span class="grammar-heading" set:html={meta.heading} />}
              {meta.bookRef && <span class="grammar-bookref" set:html={meta.bookRef} />}
            </summary>
            <div class="grammar-body"><Content /></div>
          </details>
        ))}
      </details>
    )}

    {hasVocab && (
      <details class="vocab-section" id="vocabula">
        <summary class="vocab-summary">
          <span class="section-marker">☙</span>
          <span class="section-title-inline" set:html={`Vocābula nova <span class="roman">· cap. ${numeralLower}</span>`} />
          <span class="section-summary-list">{totalVocabEntries} palavras · {vocabLabels.join(' · ')}</span>
        </summary>
        {chapter.vocabularyIntro && (
          <p class="vocab-intro" set:html={chapter.vocabularyIntro} />
        )}
        {vocabGroups.map(g => (
          <div class="vocab-group">
            <div class="vocab-group-head">
              <span class="vocab-group-label" set:html={g.label} />
              {g.tag && <span class="vocab-group-tag" set:html={g.tag} />}
            </div>
            <dl class="vocab-list">
              {g.entries.map(entry => (
                <>
                  <dt class="vocab-lemma" set:html={entry.lemma} />
                  <dd class="vocab-gloss">
                    <Fragment set:html={entry.gloss} />
                    {entry.note && (
                      <span class="vocab-note" set:html={` — ${entry.note}`} />
                    )}
                  </dd>
                </>
              ))}
            </dl>
          </div>
        ))}
      </details>
    )}

    {hasTopics && (
      <details class="topics-section" id="explicationes">
        <summary class="topics-summary">
          <span class="section-marker">❦</span>
          <span class="section-title-inline" set:html={`Explicātiōnēs <span class="roman">· referentiae · cap. ${numeralLower}</span>`} />
          <span class="section-summary-list">{topicNames.join(' · ')}</span>
        </summary>
        <p class="content-intro">
          Resumo breve para acompanhar o livro. Para a explicação completa, consulta as linhas
          indicadas em <em>Familia Romana</em>. Clica num tópico para expandir.
        </p>
        {topicsRendered.map(({ id, meta, Content }) => (
          <details class="content-topic" id={`content-${id}`}>
            <summary class="content-topic-summary">
              <span class="content-topic-marker">❦</span>
              <span class="content-topic-title" set:html={meta.title} />
              {meta.bookRef && <span class="content-topic-ref" set:html={meta.bookRef} />}
            </summary>
            <div class="content-topic-body"><Content /></div>
          </details>
        ))}
      </details>
    )}
  </section>
)}
